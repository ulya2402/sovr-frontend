---
import Layout from '../../layouts/Layout.astro';
import { VaultDetailPage } from '../../AstroWrappers.tsx';
import { slugify } from '../../App.tsx';

const { slug } = Astro.params;

const response = await fetch("https://backend-sovr.botgampang123.workers.dev/api/vault");
const allTools = await response.json();

const tool = allTools.find((t: any) => slugify(t.name) === slug);

if (!tool) {
  return Astro.redirect('/404');
}
---

<Layout title={`${tool.name} | SOVR. AI Tools`}>
  <VaultDetailPage tool={tool} allTools={allTools} client:load />
</Layout>